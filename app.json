{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1D13",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.noor.prayer",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.noor.prayer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Deen uses your location only on this phone to calculate prayer times and Qibla direction. It never leaves your device."
      },
      "supportsTablet": true
    },
    "name": "Deen: Prayer & Quran",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Deen uses your location only on this phone to calculate prayer times and Qibla direction."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0B1D13",
          "sounds": [
            "./assets/audio/azan.mp3",
            "./assets/audio/azan2.mp3",
            "./assets/audio/azan_makkah.mp3"
          ]
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-web-browser",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.noor.prayer.** { *; }\n-keep class expo.modules.** { *; }\n-keep class com.noor.inmobi.** { *; }\n-keep class com.inmobi.** { *; }\n-dontwarn com.inmobi.**\n-dontwarn expo.modules.core.errors.**\n-dontwarn expo.modules.kotlin.types.**",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Deen uses your photos to let you set a profile picture."
        }
      ]
    ],
    "scheme": "noor",
    "slug": "noor-prayer",
    "userInterfaceStyle": "automatic",
    "version": "1.0.5",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supabaseUrl": "https://vyrivhtxvdxfqliegpfr.supabase.co",
      "supabaseAnonKey": "sb_publishable_u-2_q238CPH6Z1LR_1Z1Gg_6751WY_I",
      "eas": {
        "projectId": "73dd85f5-3417-48f6-9374-686ccb7ba1af"
      }
    },
    "owner": "sohel113"
  }
}